<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>AceMq.Amqp.Avro</id>
    <version>0.5.0</version>
    <authors>AceMQ</authors>
    <license type="expression">Apache-2.0</license>
    <licenseUrl>https://licenses.nuget.org/Apache-2.0</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://acemq.org/acemq-dotnet-amqp/</projectUrl>
    <description>Avro codec for AceMq.Amqp, with fixed-schema and schema-registry modes. A separate package so the core keeps no serialization dependency.</description>
    <copyright>Copyright 2026 AceMQ</copyright>
    <tags>amqp rabbitmq messaging queue vb.net avro</tags>
    <repository type="git" url="https://github.com/AceMQ-Company/acemq-dotnet-amqp" commit="627e82ed27f15df5a9f98a4e59afa9fb75934a45" />
    <dependencies>
      <group targetFramework=".NETStandard2.0">
        <dependency id="AceMq.Amqp" version="0.5.0" exclude="Build,Analyzers" />
        <dependency id="Apache.Avro" version="1.12.2" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>